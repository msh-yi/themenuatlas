# Neon values are written to .env.local by `neon deploy` / `neon env pull`.
# DATABASE_URL (pooled, app traffic), DATABASE_URL_UNPOOLED (migrations),
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION,
# NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL

# Optional (in .env.local or .env):
# contact URL sent in the User-Agent so site owners can reach us
CONTACT_URL=https://github.com/msh-yi/themenuatlas
